<?xml version="1.0" encoding="utf-8"?>
<opc:TypeDictionary xmlns:opc="http://opcfoundation.org/BinarySchema/" xmlns:ua="http://opcfoundation.org/UA/" xmlns:tns="http://opcfoundation.org/UA/" DefaultByteOrder="LittleEndian" TargetNamespace="http://opcfoundation.org/UA/">
  <opc:StructuredType Name="KeywordHolder" BaseType="ua:ExtensionObject">
    <opc:Field Name="Type" TypeName="opc:Int32" />
    <opc:Field Name="Default" TypeName="opc:String" />
    <opc:Field Name="NoOfNames" TypeName="opc:Int32" />
    <opc:Field Name="Names" TypeName="opc:String" LengthField="NoOfNames" />
    <opc:Field Name="ServerURI" TypeName="opc:String" />
  </opc:StructuredType>
</opc:TypeDictionary>
